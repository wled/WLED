utdoor" 4-scan panels - workaround until we can make the driver user-configurable+  } else if (bc.type == TYPE_HUB75MATRIX_20S) {+      // The DMA driver emits two RGB rows in parallel. Its 40-pixel virtual-panel remap converts this 160x20 surface to one 80x40, 1/20-scan panel.+      _isVirtual = true;+      mxconfig.mx_width = min(128U, panelWidth) * 2;+      mxconfig.mx_height = min(64U, panelHeight) / 2;+      mxconfig.driver = HUB75_I2S_CFG::ICN2038S;   } else {     DEBUGBUS_PRINTLN("Unknown type");     return;   }-  _isQuadScan = (bc.type == TYPE_HUB75MATRIX_QS);+  _isVirtualScan = (bc.type == TYPE_HUB75MATRIX_QS || bc.type == TYPE_HUB75MATRIX_20S);  #if defined(CONFIG_IDF_TARGET_ESP32) || defined(CONFIG_IDF_TARGET_ESP32S2)// classic esp32, or esp32-s2: reduce bitdepth for large panels   if (mxconfig.mx_height >= 64) {@@ -921,7 +927,12 @@ BusHub75Matrix::BusHub75Matrix(const BusConfig &bc) : Bus(bc.type, bc.start, bc.   #if defined(BOARD_HAS_PSRAM) // all ESP32 pinouts require gpio 16 or 17, which are controling PSRAM     #warning "ESP32 HUB75 pinout is not compatible with PSRAM boards."   #endif-  #if defined(ESP32_FORUM_PINOUT) || defined(FORUM_ESP32_PINOUT) // Common format for boards designed for SmartMatrix+  #if defined(WLED_HUB75_80X40_ICN2038P_PINOUT)+  // ESP32 DevKit V1 wiring for the 80x40, 1/20-scan ICN2038P panel.+  DEBUGBUS_PRINTLN("MatrixPanel_I2S_DMA - WLED 80x40 ICN2038P pinout");+  mxconfig.gpio = { 25, 26, 27, 14, 12, 13, 23, 19, 5, 17, 32, 4, 15, 16 };++  #elif defined(ESP32_FORUM_PINOUT) || defined(FORUM_ESP32_PINOUT) // Common format for boards designed for SmartMatrix   DEBUGBUS_PRINTLN("MatrixPanel_I2S_DMA - ESP32_FORUM_PINOUT"); /*     ESP32 with SmartMatrix's default pinout - ESP32_FORUM_PINOUT@@ -1056,7 +1067,7 @@ BusHub75Matrix::BusHub75Matrix(const BusConfig &bc) : Bus(bc.type, bc.start, bc.   PANEL_CHAIN_TYPE chainType = CHAIN_NONE; // default for quarter-scan panels that do not use chaining   if (mxconfig.chain_length > 1 && (_row