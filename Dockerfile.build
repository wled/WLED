# AI: below section was generated by an AI
FROM node:20.18.3-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/platformio/bin:$PATH \
    PLATFORMIO_CORE_DIR=/home/node/.platformio

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/wled-requirements.txt

RUN python3 -m venv /opt/platformio \
    && /opt/platformio/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/platformio/bin/pip install --no-cache-dir -r /tmp/wled-requirements.txt \
    && rm /tmp/wled-requirements.txt \
    && mkdir -p /workspace/node_modules /home/node/.npm /home/node/.platformio \
    && chown -R node:node /workspace /home/node/.npm /home/node/.platformio

USER node
WORKDIR /workspace

CMD ["bash"]
# AI: end
